[worldserver]

###################################################################################################
#
# 	EverQuest.Enabled
#		Enable/Disables the mod as a whole, overriding any other property or setting
#	Default: True (enabled)
#
###################################################################################################

EverQuest.Enabled = True

###################################################################################################
#
# 	EverQuest.Map.RestrictPlayersToNorrath
#		Enable/Disable force keeping players in norrath. Doesn't apply to GM accounts
#	Default: False (disabled, characters can move between Norrath and Azeroth)
#
# 	EverQuest.Map.MaxExpansionID
#		Highest EverQuest expansion ID that players may enter. Zones with a higher expansion ID
#        are blocked, and any non-GM found inside one is sent to their bind point. Doesn't apply
#        to GM accounts.  Zones must have been generated by the converter to be restrictable, 
#        and this can only restrict further (it will not add zones that were never generated)
#       Values: -1 (no restriction), 0 (Classic), 1 (Kunark), 2 (Velious)
#	Default: -1 (disabled, all generated zones are reachable)
#
###################################################################################################

EverQuest.Map.RestrictPlayersToNorrath = False
EverQuest.Map.MaxExpansionID = -1

###################################################################################################
#
# 	EverQuest.Spell.TalentAlignmentEnabled
#		Lets a learned WoW talent influence a converted EverQuest spell whenever the two are
#       logically aligned.  This covers the spell modifier talents only. The talents that proc off
#       "any spell of my class" are aligned by the converter through the spell_proc table instead.
#	Default: True
#
###################################################################################################

EverQuest.Spell.TalentAlignmentEnabled = True

###################################################################################################
#
# 	EverQuest.Map.RestrictedMapCheckIntervalInSeconds
#		How often to sweep every online player and send any non-GM found on a map restricted by
#       EverQuest.Map.RestrictPlayersToNorrath or EverQuest.Map.MaxExpansionID back where they
#       belong. This is a safety net for the ways a player can reach a map without passing
#       through a blockable teleport, so it does not need to run often. Doesn't apply to GM
#       accounts, and does nothing unless one of those two restrictions is turned on.
#       NOTE: Players are sent to their EverQuest bind point, or to their race/class starting
#       position if they have never bound
#	Default: 300 (sweep every 5 minutes, 0 disables the sweep)
#
###################################################################################################

EverQuest.Map.RestrictedMapCheckIntervalInSeconds = 300

###################################################################################################
#
# 	EverQuest.Quest.GrantExpOnRepeatCompletion
#		If true, repeat quests will give exp like the first did. This is EQ-like, but not WOW-like
#       NOTE: This will only impact EverQuest IDs (range defined in this config)
#	Default: True (enabled, you get exp for repeat turnins)
#
###################################################################################################

EverQuest.Quest.GrantExpOnRepeatCompletion = True

###################################################################################################
# EXP Loss on Death Settings
#
# 	EverQuest.ExpLossOnDeath.Enabled
#		If true, you will lose experience when you release your spirit on death.  Reviving before
#        release will not cause exp loss.  Settings in this section depend on this being true.
#       NOTE: You will only lose exp if you are in a Norrath / EverQuest map
#	Default: True (enabled, lose exp when you release your body after death, if in EverQuest areas)
#
# 	EverQuest.ExpLossOnDeath.MinLevel
#		Minimum level the player needs to be before they begin losing experience
#	Default: 5 (players 4 and under do not lose exp on death release)
#
# 	EverQuest.ExpLossOnDeath.LossPercent
#		Amount of experience to lose on death (0 - 100)
#	Default: 10 (10% of experience is lost on death)
#
# 	EverQuest.ExpLossOnDeath.AddLostExpToRestExp
#		If true, experience lost will be added to rest experience.  This allows the player to not
#        lose net progress as long as they don't overfill their rest experience bar
#	Default: True (enabled, experience lost is put into rest experience)
#
###################################################################################################

EverQuest.ExpLossOnDeath.Enabled = True
EverQuest.ExpLossOnDeath.MinLevel = 5
EverQuest.ExpLossOnDeath.LossPercent = 10
EverQuest.ExpLossOnDeath.AddLostExpToRestExp = True

###################################################################################################
#
# 	EverQuest.AlternateGroupExperienceFormula.Enabled
#		If true, exp granted while in a group will be different based on AddPercentPerMember
#	Default: False (group exp is reduced like a live server)
#
# 	EverQuest.AlternateGroupExperienceFormula.AddPercentPerMember
#		When enabled, this is how much bonus experience to grant each party member based on
#       number in the group beyond 1.  For example, 20% would mean that if 3 party members are in the
#       group then exp per member would be "(CreatureKillEXPReward / 3) + ((3 - 1) * 0.2"
#       Only members that are online, alive, and close enough to the kill to share it are counted
#       toward the member number.
#	Default: 20 (Matches EQ's 20% per member bonus in 2003)
#
###################################################################################################

EverQuest.AlternateGroupExperienceFormula.Enabled = False
EverQuest.AlternateGroupExperienceFormula.AddPercentPerMember = 20

###################################################################################################
#
# 	EverQuest.Spells.DisableStackingOfSameDOT
#		If true, spells that apply the same dot will not stack, which is EQ-like
#	Default: False (use WoW behavior)
#
###################################################################################################

EverQuest.Spells.DisableStackingOfSameDOT = False

###################################################################################################
#
# 	EverQuest.Spells.BuffLevelRestrictionsEnabled
#		If true, beneficial buffs above spell level 50 will not land on players below level
#		(spell level / 2) + 15, matching EverQuest behavior. Applies to direct casts, group and
#		area landings, item clickies, and procs. Bard songs are exempt.
#	Default: True (use EverQuest behavior)
#
###################################################################################################

EverQuest.Spells.BuffLevelRestrictionsEnabled = True

###################################################################################################
#
# 	EverQuest.Spells.CrowdControlLevelRestrictionsEnabled
#		If true, player-cast stun, mesmerize, and charm spells will not land on creatures above the
#       spell's EverQuest max target level (stuns default to a max of level 55 when the	EverQuest
#       spell had none), matching EverQuest behavior.  Creature casters (including player pets) are
#       exempt.  Stuns only lose the stun portion, not any other effect (like damage).
#	Default: True (use EverQuest behavior)
#
###################################################################################################

EverQuest.Spells.CrowdControlLevelRestrictionsEnabled = True

###################################################################################################
#
# 	EverQuest.Spells.HasteCapEnabled
#		If true, attack speed bonuses ("haste") from EverQuest sources follow EverQuest stacking
#		rules.  Haste falls into three categories that never stack within themselves - worn item
#		effects, spell/song/clicky haste (v1), and v2 haste (some bard songs) - so only the
#		strongest buff of each category applies (weaker ones stay visible but contribute nothing).
#		The categories then add together additively (not multiplicatively like WoW) and the total
#		is capped: players cap at level+25 through level 50, 85 for 51-59, and
#		EverQuest.Spells.HasteCapPercent at 60+.  Worn haste is capped at 10 until level 26, and
#		v2 haste only works at level 50+ and adds at most 10.  Pets and other creatures use the
#		TAKP creature caps.  WoW haste sources are unaffected and stack normally on top.
#	Default: True (use EverQuest behavior)
#
# 	EverQuest.Spells.HasteCapPercent
#		The maximum combined attack speed bonus percent from EverQuest sources for players
#		at level 60 and above (matches the TAKP Character.HasteCap rule)
#	Default: 100
#
###################################################################################################

EverQuest.Spells.HasteCapEnabled = True
EverQuest.Spells.HasteCapPercent = 100

###################################################################################################
#
# 	EverQuest.Spells.BardFearDiminishingReturnsEnabled
#		If true, the fear from a bard fear song diminishes on creature targets the way WoW fear
#		already diminishes on players - the first landing lasts its full duration, the next one
#		half, the one after a quarter, and then the creature is immune until the chain resets
#	Default: True (bard song fear diminishes)
#
# 	EverQuest.Spells.BardFearDiminishingReturnsResetTimeInMS
#		How long a creature must go without a new bard song fear landing on it, after the last
#		one would have run out, before the diminishing chain resets back to full duration.
#	Default: 15000 (15 seconds, matching the WoW diminishing returns reset)
#
###################################################################################################

EverQuest.Spells.BardFearDiminishingReturnsEnabled = True
EverQuest.Spells.BardFearDiminishingReturnsResetTimeInMS = 15000

###################################################################################################
#
# 	EverQuest.CombatSkills.DisableBashKickStunOnPlayers
#		If true, the stun part of Bash/Kick/Slam combat skills will never land on player targets.
#	Default: False (players can be stunned by these combat skills)
#
###################################################################################################

EverQuest.CombatSkills.DisableBashKickStunOnPlayers = False

###################################################################################################
#
# 	EverQuest.CombatSkills.RangedAttackEnabled
#		If true, creatures that have the EQ "ranged attack" special ability, or that roll both a bow
#		and an arrow in their loot, will shoot targets that are out of melee reach (mirrors TAKP)
#		The ranged attack spell itself must also have been generated by EQWOWConverter
#	Default: True
#
#	EverQuest.CombatSkills.RangedAttackDefaultMinRange
#	EverQuest.CombatSkills.RangedAttackDefaultMaxRange
#		The min/max distance band (in WOW world units) used when a creature does not specify its own
#		range via the special ability. Defaults map to TAKP's 25 / 250 EQ units
#       IMPORTANT: These values are multiplied by the world scale from the converter (typically 0.29)
#	Default: 25 / 250
#
#	EverQuest.CombatSkills.RangedAttackDamageMultiplier
#		Multiplies the creature's melee damage to produce its ranged damage (TAKP ArcheryNPCMultiplier)
#	Default: 1.0
#
###################################################################################################

EverQuest.CombatSkills.RangedAttackEnabled = True
EverQuest.CombatSkills.RangedAttackDefaultMinRange = 25
EverQuest.CombatSkills.RangedAttackDefaultMaxRange = 250
EverQuest.CombatSkills.RangedAttackDamageMultiplier = 1.0

###################################################################################################
#
# 	EverQuest.CombatSkills.EnrageEnabled
#		If true, creatures with the EQ "enrage" special ability riposte all frontal melee swings
#		(parry + counterattack) for a short duration when low on health (mirrors TAKP)
#	Default: True
#
#	EverQuest.CombatSkills.EnrageDefaultHPPercent
#		Health percent at/below which an enrage starts, when the creature does not specify its own
#	Default: 10
#
#	EverQuest.CombatSkills.EnrageDefaultDurationInMS
#	EverQuest.CombatSkills.EnrageDefaultCooldownInMS
#		How long an enrage lasts and how long until it can happen again, when the creature does not
#		specify its own values
#	Default: 10000 / 360000
#
# 	EverQuest.CombatSkills.FlurryEnabled
#		If true, creatures with the EQ "flurry" special ability can perform an extra attack round
#		on their current target
#	Default: True
#
#	EverQuest.CombatSkills.FlurryDefaultChancePercent
#		Chance per attack round to flurry, when the creature does not specify its own
#	Default: 20
#
# 	EverQuest.CombatSkills.RampageEnabled
#		If true, creatures with the EQ "rampage" special ability can strike an extra hate list
#		member that isn't their current target
#	Default: True
#
#	EverQuest.CombatSkills.RampageDefaultChancePercent
#		Chance per attack round to rampage, when the creature does not specify its own
#	Default: 20
#
#	EverQuest.CombatSkills.RampageDefaultRange
#		Max distance a rampage target can be, when the creature does not specify its own.
#       Note: Multiplied by world scale from the converter (typically 0.29)
#	Default: 75
#
# 	EverQuest.CombatSkills.WildRampageEnabled
#		If true, creatures with the EQ "area rampage" (wild rampage) special ability can strike
#		everyone on their hate list in melee range, like a WoW cleave
#	Default: True
#
#	EverQuest.CombatSkills.WildRampageDefaultChancePercent
#		Chance per attack round to area rampage, when the creature does not specify its own
#	Default: 20
#
#	EverQuest.CombatSkills.WildRampageDefaultMaxTargets
#		Max hate list members struck by one area rampage, when the creature does not specify its own
#	Default: 999
#
# 	EverQuest.CombatSkills.RaidBossSummonEnabled
#		If true, raid boss creatures will yank their current target back to them whenever that target
#		is out of melee reach, which is the EQ "summon" behavior that stops bosses from being kited
#		Only creatures marked as a raid boss by EQWOWConverter can do this
#	Default: True
#
#	EverQuest.CombatSkills.RaidBossSummonMaxHealthPercent
#		A boss will not summon until its health is at or below this percent, so a fully healthy boss
#		leaves its target alone (mirrors TAKP)
#	Default: 97
#
#	EverQuest.CombatSkills.RaidBossSummonCooldownInMS
#		How long a boss waits between summons
#	Default: 11000
#
###################################################################################################

EverQuest.CombatSkills.EnrageEnabled = True
EverQuest.CombatSkills.EnrageDefaultHPPercent = 10
EverQuest.CombatSkills.EnrageDefaultDurationInMS = 10000
EverQuest.CombatSkills.EnrageDefaultCooldownInMS = 360000
EverQuest.CombatSkills.FlurryEnabled = True
EverQuest.CombatSkills.FlurryDefaultChancePercent = 20
EverQuest.CombatSkills.RampageEnabled = True
EverQuest.CombatSkills.RampageDefaultChancePercent = 20
EverQuest.CombatSkills.RampageDefaultRange = 75
EverQuest.CombatSkills.WildRampageEnabled = True
EverQuest.CombatSkills.WildRampageDefaultChancePercent = 20
EverQuest.CombatSkills.WildRampageDefaultMaxTargets = 999
EverQuest.CombatSkills.RaidBossSummonEnabled = True
EverQuest.CombatSkills.RaidBossSummonMaxHealthPercent = 97
EverQuest.CombatSkills.RaidBossSummonCooldownInMS = 11000

###################################################################################################
# Evade / Unstick Settings (EverQuest maps only, except NonEQMapLeashRadius)
#
# 	EverQuest.Evade.Enabled
#		If true, EverQuest maps use the EQ-style unreachable handling below instead of the core's
#		fixed unreachable-evade behavior. Non-EverQuest maps are never affected
#	Default: True
#
# 	EverQuest.Evade.UnreachableEvadeSeconds
#		Base timer, in seconds, a creature may remain genuinely stuck (out of melee, not casting, not
#		movement impaired, not making progress) before it evades. Reached only once unstick teleport
#		attempts are exhausted, since each attempt resets this timer
#	Default: 10
#
# 	EverQuest.Evade.UnstickStallSeconds
#		Seconds a creature must be stuck (as above, staying within UnstickMoveThreshold yards of where
#		it was when the stall window opened) before it teleports partway towards its target (see
#		UnstickStepPercent) to unstick itself. A creature that keeps relocating (actively chasing)
#		never reaches this
#	Default: 3
#
# 	EverQuest.Evade.UnstickSettleSeconds
#		After an unstick teleport, seconds the creature stops chasing and delays its melee swing before
#		resuming aggression (an AI spellcast may still fire)
#	Default: 1
#
# 	EverQuest.Evade.UnstickMoveThreshold
#		Distance, in yards, a creature must travel from its stall-window anchor to count as making
#		progress (which resets the stuck timer). Keeps creatures that are actively chasing a player they
#		cannot catch from being treated as stuck and teleporting onto the player. Lower is 'stricter'
#	Default: 3
#
# 	EverQuest.Evade.UnstickMaxAttempts
#		Maximum unstick teleports per aggro session. The counter resets when the creature evades, loses
#		aggro, dies, or respawns. Set to 0 to disable teleporting (creatures simply evade on the base timer)
#	Default: 3
#
# 	EverQuest.Evade.UnstickStepPercent
#		Percent of the distance towards the target each unstick teleport covers, clamped to 1-100. When
#		the target is above the creature, a stepped spot only qualifies if it has a floor (at the spot's
#		height, or failing that at the target's height). if neither exists the step advances by this
#		percent again (50%, 75%, ...) until a floor is found, with the target's own position as the final
#		fallback. 100 always teleports directly onto the target player.
#	Default: 25
#
# 	EverQuest.Evade.NonEQMapLeashRadius
#		Distance, in yards, a creature on a NON-EverQuest map may pursue beyond its home/waypoint
#		position before it evades, reimplementing the core CreatureLeashRadius check (worldserver's
#		CreatureLeashRadius must be set to 0 so creatures on EverQuest maps, particularly bosses,
#		never distance-leash). As in core, a non-boss only evades this way once its leash timer has
#		lapsed (no recent direct damage, melee contact, or crowd control) and it has no taunt aura,
#		while world bosses ignore the timer and taunts. Set to 0 to disable the non-EQ leash as well
#	Default: 30
#
###################################################################################################

EverQuest.Evade.Enabled = True
EverQuest.Evade.UnreachableEvadeSeconds = 10
EverQuest.Evade.UnstickStallSeconds = 3
EverQuest.Evade.UnstickSettleSeconds = 1
EverQuest.Evade.UnstickMoveThreshold = 3
EverQuest.Evade.UnstickMaxAttempts = 3
EverQuest.Evade.UnstickStepPercent = 25
EverQuest.Evade.NonEQMapLeashRadius = 30

###################################################################################################
# Charm Settings (creature-cast charms only, player charms are unaffected)
#
# 	EverQuest.Charm.CreatureCharmLimitsEnabled
#		If true, creatures casting charm spells follow two extra rules: a creature can only have one
#		player charmed at a time (so a recharming creature can't chain-charm player after player), and
#		a creature will only charm a player when at least one other uncharmed player is nearby (so the
#		last free player in a group is never charmed)
#	Default: True
#
# 	EverQuest.Charm.UncharmedPlayerCheckRadius
#		Distance, in WOW world units from the casting creature, used when counting nearby uncharmed
#		players for the rule above. Dead players, charmed players, and game masters never count
#	Default: 100
#
###################################################################################################

EverQuest.Charm.CreatureCharmLimitsEnabled = True
EverQuest.Charm.UncharmedPlayerCheckRadius = 100

###################################################################################################
# Faction Settings
#
# 	EverQuest.Faction.DefendFriendlyPlayersEnabled
#		If true, creatures on a faction flagged as WillDefendFriendlyPlayers (city guards, citizens,
#		and the like) come to the aid of a nearby player they are friendly with when that player is
#		attacked by a creature on a faction flagged as DefendersWillAttackToDefendPlayer.
#	Default: True (friendly factions defend players)
#
###################################################################################################

EverQuest.Faction.DefendFriendlyPlayersEnabled = True

###################################################################################################
# Creature Emote Settings (EQ-faithful creature says/emotes/yells)
#
# 	EverQuest.CreatureEmotes.Enabled
#		If true, creatures speak their EQ npc_emotes lines on events: enter combat, leave combat,
#		death, killing a player, spawn, despawn, and being talked to (In Wow it's a Gossip, in EQ
#       it's a "hail")
#	Default: True
#
# 	EverQuest.CreatureEmotes.AmbientEnabled
#		If true, ambient speech extracted from the EQ quest scripts also plays: timed roamer statements
#		(like Nillipuss in Rivervale) and proximity-triggered speech (like the invisible 'trigger'
#		creatures in Chardok).  Requires EverQuest.CreatureEmotes.Enabled
#	Default: True
#
###################################################################################################

EverQuest.CreatureEmotes.Enabled = True
EverQuest.CreatureEmotes.AmbientEnabled = True

###################################################################################################
# Creature Movement Sound Settings (EQ-like walk/run sound loops)
#
# 	EverQuest.CreatureMovementSounds.Enabled
#		If true, creatures play their EQ walk sound as a continuous loop while walking and their
#		EQ run sound while running, like the EQ client did.  The loop is driven by the server
#		(replayed back-to-back at the sound file length) because the WoW client cannot loop a
#		sound linked on unit movement by itself in full loops
#	Default: True
#
###################################################################################################

EverQuest.CreatureMovementSounds.Enabled = True

###################################################################################################
#
# 	EverQuest.Illusion.GearRefreshTimeInMS
#		How often, in milliseconds, an illusioned player's gear-matched display is revalidated. This
#		catches changes that have no event hooks, like unequipping the chest item or toggling the
#		"Show Helm" interface option. Zero or below disables the periodic revalidation entirely, so the
#		display only updates when an illusion spell lands or an item is equipped
#	Default: 1000 (1 second)
#
###################################################################################################

EverQuest.Illusion.GearRefreshTimeInMS = 1000

###################################################################################################
#
# 	EverQuest.ShowClassMessageOnLogin
#		If true, a chat message describing the player's primary (and secondary) EQ class is shown
#		on login.
#	Default: True (class message on login)
#
###################################################################################################

EverQuest.ShowClassMessageOnLogin = True

###################################################################################################
# Secondary Experience Pool Settings
#
# 	EverQuest.SecondaryExpPool.GainPercent
#		When a character kills a creature, this percent of the kill's experience is added to a per-character 
#       "secondary bonus experience pool" as EXTRA experience.  The experience earned by the killing
#       character is NOT reduced to produce it.  The player can later apply the pooled experience
#       to the active character from the EQ Class character tab. Set to 0 to disable the pool entirely.
#	Default: 25 (quarter of the kill's experience is also banked into the pool)
#
# 	EverQuest.SecondaryExpPool.MaxPooled
#		Maximum amount of experience that can be held in the pool.  Once full, further kills add nothing
#		to the pool until some is spent.
#	Default: 1000000
#
###################################################################################################

EverQuest.SecondaryExpPool.GainPercent = 25
EverQuest.SecondaryExpPool.MaxPooled = 1000000

###################################################################################################
#
# 	EverQuest.Player.LevelCap
#		If set to a non-zero level, players can never reach that level through normal play.
#        Experience keeps filling the bar on the level below it, but stops one experience point
#        short of leveling and freezes there.  Example: if set to 61, players can only reach
#        level 60, their level 60 experience bar fills to one point short of flipping, and no
#        amount of experience from any source will make them level 61.  GM commands that grant
#        levels directly (like .levelup and .character level) are NOT capped and still work.
#       NOTE: The worldserver.conf MaxPlayerLevel setting must still be at or higher than this
#        value for this setting to have any effect, since the core stops all experience gain
#        outright at MaxPlayerLevel and the bar could never fill on the level below this cap.
#	Default: 0 (disabled, no level cap is enforced by the mod)
#
###################################################################################################

EverQuest.Player.LevelCap = 0

###################################################################################################
#
# 	EverQuest.Player.ShieldArmorIgnoresBearFormMultiplier
#		Bear form and dire bear form multiply all armor that equipped items contribute.  Shields are
#		usable by druids in EQ, and if true an equipped shield's armor is left out of that
#		multiplier while one of those forms is held, so the shield still gives its normal armor but
#		does not get scaled up by the form.  All other armor (and every percent-based armor effect)
#		is unaffected.
#	Default: True (shield armor is not multiplied by bear/dire bear form)
#
###################################################################################################

EverQuest.Player.ShieldArmorIgnoresBearFormMultiplier = True

###################################################################################################
#
# 	EverQuest.Player.AddHearthstoneToNewCharacters
#		If true, characters are given a Hearthstone (item 6948) on their first login if they do
#		not already have one.  The EverQuest starting item loadouts generated by the converter do
#		not include a hearthstone, so this setting controls whether new characters get one at all.
#	Default: True (new characters receive a hearthstone on first login)
#
###################################################################################################

EverQuest.Player.AddHearthstoneToNewCharacters = True

###################################################################################################
#
# 	EverQuest.Player.AddMasterTotemToShamans
#		If true, shaman characters are given a Totem of the Elements (item 46978) on every login
#		unless they are already carrying a master totem.  A master totem is any single item that
#		satisfies the air, earth, fire and water totem requirements at the same time, so a shaman
#		holding one can cast every totem spell without carrying the four individual totems.  The
#		bank is not searched, only equipped items, the backpack and any equipped bags.
#	Default: True (shamans are kept supplied with a master totem)
#
###################################################################################################

EverQuest.Player.AddMasterTotemToShamans = True

###################################################################################################
#
# 	EverQuest.Player.AddRacialGuiseItemOnLogin
#		If true, every character is given their racial guise (based on start town) consumable at 
#       login, but only one time.  If the player doesn't have space then it will be reattempted the
#       next time they log in
#	Default: True
#
###################################################################################################

EverQuest.Player.AddRacialGuiseItemOnLogin = True

###################################################################################################
#
# 	EverQuest.Achievement.AdventurerLevel
#		Level a character must reach while still holding the "Everquest Adventurer" aura to earn
#		the matching feat of strength for their account.  The aura is granted at character
#		creation and is lost by taking part in any non-Everquest content, so reaching this level
#		with it still active means the character only ever adventured through Everquest content.
#		Set to 0 to stop the feat of strength from ever being awarded through leveling.
#		NOTE: This has no effect unless the converter generated the achievement and its aura
#		 (EQWOWConverter's ACHIEVEMENT_EQ_ADVENTURER_ENABLED).
#	Default: 60
#
# 	EverQuest.Achievement.AdventurerProtectedInEQZones
#       If true, a player in an EverQuest map/zone who has the Adventurer buff cannot lose it by any means
#   Default: True (can't lose it in an EverQuest map)
#
###################################################################################################

EverQuest.Achievement.AdventurerLevel = 60
EverQuest.Achievement.AdventurerProtectedInEQZones = True

###################################################################################################
#
# 	EverQuest.CrossClass.IncludeSkillIDs
#		Comma delimited list of skill IDs that remain when you switch eq classes
#	Default: list is related to professions, flying, pick lock, ...
#
###################################################################################################

EverQuest.CrossClass.IncludeSkillIDs = 129, 164, 165, 171, 182, 185, 186, 197, 202, 333, 356, 393, 755, 762, 773

###################################################################################################
# Client Version Check Settings
#
# 	EverQuest.ClientVersionCheck.Enabled
#		If true, players must be running a client patch MPQ matching the deployed content or they
#		are kicked shortly after entering the world.
#	Default: False
#
# 	EverQuest.ClientVersionCheck.GraceTimeInSeconds
#		How long after entering the world the server waits for the client's version report before
#		treating the client as out of date
#	Default: 30
#
# 	EverQuest.ClientVersionCheck.KickDelayInSeconds
#		How long after showing the out-of-date message the player is kicked, so the message can
#		be read
#	Default: 10
#
###################################################################################################

EverQuest.ClientVersionCheck.Enabled = False
EverQuest.ClientVersionCheck.GraceTimeInSeconds = 30
EverQuest.ClientVersionCheck.KickDelayInSeconds = 10

###################################################################################################
# Tracking Settings
#
# 	EverQuest.Tracking.Enabled
#		If true, players with a primary or secondary EQ class of Ranger, Druid, or Bard can use
#		the Tracking ability (cast the Tracking spell or use the EQ_Tracking addon window) to
#		list nearby creatures and follow one via periodic direction messages
#	Default: True (tracking is available)
#
# 	EverQuest.Tracking.RangerYardsPerLevel
# 	EverQuest.Tracking.DruidYardsPerLevel
# 	EverQuest.Tracking.BardYardsPerLevel
#		How many yards of track range a class gets per level (range = level x this, clamped to
#		the max range below).  Rangers are the best trackers in EverQuest, so this is the largest
#	Default: 20 (Ranger), 15 (Druid), 10 (Bard)
#
# 	EverQuest.Tracking.RangerMaxRange
# 	EverQuest.Tracking.DruidMaxRange
# 	EverQuest.Tracking.BardMaxRange
#		The most yards a class's track range can ever reach, no matter their level
#	Default: 600 (Ranger), 300 (Druid), 180 (Bard)
#
#	NOTE: When both the primary and the secondary EQ class can track, only the class that
#	 yields the highest range at the player's level is in effect
#
# 	EverQuest.Tracking.MaxResults
#		The most creatures a track scan will return, nearest first.  0 means no limit (every
#		trackable creature in range is listed)
#	Default: 0
#
# 	EverQuest.Tracking.PulseIntervalInMS
#		How often (in milliseconds) the direction message repeats while tracking a creature.
#		Values under 1000 are raised to 1000
#	Default: 5000 (every 5 seconds)
#
###################################################################################################

EverQuest.Tracking.Enabled = True
EverQuest.Tracking.RangerYardsPerLevel = 20
EverQuest.Tracking.DruidYardsPerLevel = 15
EverQuest.Tracking.BardYardsPerLevel = 10
EverQuest.Tracking.RangerMaxRange = 600
EverQuest.Tracking.DruidMaxRange = 300
EverQuest.Tracking.BardMaxRange = 180
EverQuest.Tracking.MaxResults = 0
EverQuest.Tracking.PulseIntervalInMS = 5000

###################################################################################################
# Spell Settings
#
# 	EverQuest.Spell.SummonPlayerAcrossZones
#		If true, the EverQuest summon player effect (Call of the Hero and the like) can pull a
#		player in from any zone on the server, instead of only from the zone the caster is standing
#		in.  The summoned player gets the same accept or decline prompt either way, and the summon
#		sends them to where the caster stood when the spell landed.  Player must be in the party or raid
#		EverQuest itself could only summon inside a zone, so this is off by default.
#	Default: False (a summon only reaches into the caster's own zone)
#
###################################################################################################

EverQuest.Spell.SummonPlayerAcrossZones = False

###################################################################################################
# Group Settings
#
# 	EverQuest.Group.ZoneWideLootAndExperienceEnabled
#		If true, the whole party or raid counts as being at a kill as long as they are in the same
#		EverQuest zone, instead of only the members standing inside the core's MaxGroupXPDistance.
#		NOTE: This only applies inside EverQuest zones.  Kills in Azeroth keep the normal behavior
#		NOTE: Instanced EverQuest maps already share a kill across the whole instance on their own,
#		 so this changes nothing there
#		NOTE: Splitting the kill across more members lowers what each one earns, exactly as it
#		 would have if the whole group had been standing at the kill
#	Default: True (the whole group in the zone shares the kill)
#
###################################################################################################

EverQuest.Group.ZoneWideLootAndExperienceEnabled = True
